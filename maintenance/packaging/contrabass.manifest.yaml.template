# Mole Agent deployment bundle — manifest template for tar.gz packages.
# - Paths are relative to the archive root (flat ./name layout).
# - Placeholders are substituted by maintenance/scripts/pack-agent-tarball.sh (64-char hex sha256).
# - See maintenance/packaging/contrabass.manifest.example.yaml for a filled-out sample.

manifestVersion: 2

bundle:
  format: tar.gz

agent_control:
  path: ./contrabass-moleU-control
  sha256: "__CONTROL_SHA256__"

agent_compute:
  path: ./contrabass-moleU-compute
  sha256: "__COMPUTE_SHA256__"

config:
  path: ./agent.local.yml
  sha256: "__CONFIG_SHA256__"
